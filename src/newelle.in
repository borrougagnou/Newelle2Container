import os
import sys
import signal
import locale
import gettext

VERSION = '@VERSION@'

# AppImage-aware path resolution
if os.environ.get('APPDIR'):
    APPDIR = os.environ.get('APPDIR', '')
    pkgdatadir = os.path.join(APPDIR, 'share', 'newelle')
    localedir = os.path.join(APPDIR, 'share', 'locale')
else:
    pkgdatadir = '@pkgdatadir@'
    localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)
locale.bindtextdomain('newelle', localedir)
locale.textdomain('newelle')
gettext.install('newelle', localedir)

if __name__ == '__main__':
    import gi
    from gi.repository import Gio
    
    # GResource loads from specified path
    gresource_path = os.path.join(pkgdatadir, 'newelle.gresource')
    print(f"Loading GResource: {gresource_path}", file=sys.stderr)
    if not os.path.exists(gresource_path):
        print(f"ERROR: GResource: {gresource_path}: file not found!", file=sys.stderr)

    try:
        resource = Gio.Resource.load(gresource_path)
        resource._register()
        print("GResource loaded successfully", file=sys.stderr)
    except Exception as e:
        print(f"ERROR: GResource loading: {e}", file=sys.stderr)
        sys.exit(1)

    from newelle import main
    sys.exit(main.main(VERSION))
